{
  "name": "nalanda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,app -c cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite frontend",
    "dev:backend": "node backend/server.js",
    "build": "vite build frontend",
    "preview": "vite preview frontend",
    "test": "vitest run",
    "test:security": "vitest run --config vitest.security.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "routes:inventory": "node scripts/authorization-matrix.mjs --json",
    "db:bootstrap": "node backend/src/db/bootstrap.js",
    "db:migrate": "node backend/src/db/migrate.js",
    "db:backfill": "node backend/src/db/backfill.js",
    "db:verify-identity": "node backend/src/db/verify-identity.mjs",
    "db:verify-attempts": "node backend/src/db/verify-attempts.mjs",
    "db:verify-certificates": "node backend/src/db/verify-certificates.mjs",
    "db:verify-candidate-assessments": "node backend/src/db/verify-candidate-assessments.mjs",
    "db:verify-privacy": "node backend/src/db/verify-privacy.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@google/genai": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.5",
    "tailwind-merge": "3.4.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "supertest": "^7.3.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}

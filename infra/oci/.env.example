# ==============================================================================
# Nalanda LMS — Oracle Cloud Infrastructure (OCI) Environment Configuration
# ==============================================================================

# Runtime mode: standalone production on OCI
NODE_ENV=production
STANDALONE_MODE=1
PORT=8080

# Domain for Caddy automatic HTTPS (e.g. lms.yourcompany.com or empty for port 80 HTTP)
DOMAIN=
ACME_EMAIL=admin@example.com

# Database credentials (PostgreSQL)
DB_USER=nalanda
DB_PASSWORD=replace_with_strong_random_db_password
DB_NAME=nalanda
DATABASE_URL=postgresql://nalanda:replace_with_strong_random_db_password@postgres:5432/nalanda
PGSSL=disable

# Cache credentials (Redis)
REDIS_PASSWORD=replace_with_strong_random_redis_password
REDIS_URL=redis://:replace_with_strong_random_redis_password@redis:6379

# Cryptographic secrets (must be random 64-character strings in production)
JWT_SECRET=replace_with_random_64_character_hex_jwt_secret
CERTIFICATE_SIGNING_SECRET=replace_with_random_64_character_hex_cert_secret

# Seeded admin credentials
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

# AI Copilot (Gemini API key for course authoring and Acharya tutor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Base URL and Allowed Origins for Web & Proctoring Links
BASE_URL=http://localhost
ALLOWED_ORIGINS=

# ── Nalanda environment configuration ──
# Copy to .env and fill in real values. NEVER commit the real .env.

# Server
PORT=8080
# Set NODE_ENV=production in deployed environments (enables Secure cookies and
# refuses to boot on a weak/default JWT secret).
NODE_ENV=development

# Auth — REQUIRED in production. Must be a strong, random, >= 32 char value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS — comma-separated list of allowed browser origins (production).
# Leave empty when the SPA is served from the same origin as the API.
ALLOWED_ORIGINS=

# Seed/bootstrap account passwords (set these in production to bootstrap access;
# without them, seeded accounts get random unknown passwords).
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# Persistence
# If DATABASE_URL is set, state is stored durably in PostgreSQL (pooled,
# transactional). If unset, the app falls back to an atomic local JSON file
# (database/db.json) — fine for dev, NOT recommended for production.
# Example: postgres://user:password@host:5432/nalanda
DATABASE_URL=
# TLS for PostgreSQL: "require" (verify cert), "no-verify" (managed self-signed),
# or leave empty for local non-TLS Postgres.
PGSSL=
# Max PostgreSQL pool connections (default 10).
PGPOOL_MAX=10

# Google Gemini (optional — AI features degrade to deterministic fallback if absent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Nalanda environment configuration ──
# Copy to .env and fill in real values. NEVER commit the real .env.

# Server
PORT=8080
# Set NODE_ENV=production in deployed environments (enables Secure cookies and
# refuses to boot on a weak/default JWT secret).
NODE_ENV=development

# Auth — REQUIRED in production. Must be a strong, random, >= 32 char value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Stable token namespace; change only as a coordinated session-revoking event.
JWT_ISSUER=nalanda-api
JWT_AUDIENCE=nalanda-web
# Separate credential-signing key — REQUIRED in production, >= 32 characters.
CERTIFICATE_SIGNING_SECRET=
# Manual certificate issuance is disabled until an explicit approval role is set.
# Recommended: Admin
CERTIFICATE_ISSUANCE_APPROVAL_ROLE=

# Express proxy trust. Keep false unless a known reverse proxy is deployed.
# Valid examples: false, loopback, 1
TRUST_PROXY=false

# Short-lived mobile companion bearer lifetime (60-3600 seconds).
COMPANION_TOKEN_TTL_SECONDS=900

# Razorpay checkout. All three secrets are required for a production payment
# deployment. The order TTL is constrained to 300-86400 seconds.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_ORDER_TTL_SECONDS=1800

# CORS — comma-separated list of allowed browser origins (production).
# Leave empty when the SPA is served from the same origin as the API.
ALLOWED_ORIGINS=

# Seed/bootstrap account passwords (set these in production to bootstrap access;
# without them, seeded accounts get random unknown passwords).
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# Persistence
# If DATABASE_URL or the standard PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD
# variables are set, state is stored durably in PostgreSQL (pooled,
# transactional). If unset, the app falls back to an atomic local JSON file
# (database/db.json) — fine for dev, NOT recommended for production.
# Example: postgres://user:password@host:5432/nalanda
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=nalanda
PGUSER=
PGPASSWORD=
# TLS for PostgreSQL: "require" (verify cert), "no-verify" (managed self-signed),
# or leave empty for local non-TLS Postgres.
PGSSL=
# Max PostgreSQL pool connections (default 10).
PGPOOL_MAX=10
# Phase-2 relational cutover flags (per entity). When =1, that entity's reads/
# writes use the normalized PostgreSQL tables instead of the in-memory store.
# Requires DATABASE_URL/PGHOST + baseline/migrations applied + backfill and
# reconciliation run. Default off.
USE_PG_SKILLS=
# Relational payment ledger + enrollment transaction. Keep off until the
# Phase-6 payment reconciliation and live PostgreSQL concurrency tests pass.
USE_PG_PAYMENTS=
# Relational identity and server-authoritative session versions. Keep off until
# Phase-7 identity reconciliation and live PostgreSQL failover tests pass.
USE_PG_IDENTITY=
# Relational assessment attempts, exam clocks, grading transitions and proctor
# evidence. Keep off until Phase-8 backfill/reconciliation and concurrency tests pass.
USE_PG_ATTEMPTS=
# Transactional certificate issuance, enrollment certification, verification
# and revocation. Keep off until Phase-9 reconciliation/live verifier passes.
USE_PG_CERTIFICATES=
# Transactional public candidate links, sessions, grading and proctor evidence.
# Keep off until Phase-10 backfill/reconciliation and cross-task verifier pass.
USE_PG_CANDIDATE_ASSESSMENTS=
# Experimental transactional course/catalog authority. Phase 12 deliberately
# makes readiness fail while this is enabled until chapter/progress consumers
# are migrated and reconciled. Do not enable in AWS yet.
USE_PG_COURSES=
# Durable privacy request/review/erasure workflow. Enable only after every
# normalized source-of-truth flag and the Phase-11 coverage verifier pass.
USE_PG_PRIVACY=
ENABLE_PRIVACY_ERASURE_WORKER=
PRIVACY_COVERAGE_ACK=
PRIVACY_PSEUDONYM_SECRET=
PRIVACY_ERASURE_INTERVAL_MS=300000
PRIVACY_ERASURE_BATCH_SIZE=10

# Distributed request controls. Required in production. Use rediss:// when
# ElastiCache transit encryption is enabled.
REDIS_URL=

# Private object storage. The deployed task should use an IAM task role; do not
# inject static AWS access keys.
S3_BUCKET=
S3_REGION=ap-south-1

# Google Gemini (optional — AI features degrade to deterministic fallback if absent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
